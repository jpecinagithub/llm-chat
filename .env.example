# Local development only — copy to .env (never commit real values).
# Production values go in the Vercel dashboard: Project → Settings → Environment Variables.

# Public HTTPS URL of the Cloudflare tunnel pointing at the LLM gateway
LLM_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# Bearer token required by the gateway (must match GATEWAY_TOKEN on the server)
GATEWAY_TOKEN=your-gateway-token-here
